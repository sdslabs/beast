# ==============================================================================
# Beast Redis Configuration
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis Built-in 'default' User Password (used by general tools/redis-cli)
REDIS_DEFAULT_PASSWORD=redis_default_password

# Redis Application User & Password (used by Beast)
REDIS_USER=beast_user
REDIS_PASSWORD=doorword
REDIS_DB=0

# ==============================================================================
# Beast PostgreSQL Configuration
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PostgreSQL Superuser (single administrative user used by Beast)
POSTGRES_USER=beast_database_postgress_user
POSTGRES_PASSWORD=doorword
POSTGRES_DB=beast
POSTGRES_SSLMODE=prefer

# ==============================================================================
# Beast Logging Configuration
# ==============================================================================
# Enable full API HTTP request & response logging (methods, URLs, status, bodies)
LOG_HTTP_PAYLOADS=false
