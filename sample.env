# ==============================================================================
# Beast Environment Variables Configuration Template
# Copy this file to .env (e.g. `cp sample.env .env`) and adjust for your setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# Platform Environment & Runtime
# ------------------------------------------------------------------------------
# development | production
BEAST_ENV=production

# Keep this false in production! True logs full request and response bodies.
BEAST_LOG_HTTP_PAYLOADS=false

# ------------------------------------------------------------------------------
# Authentication & Security Secrets
# ------------------------------------------------------------------------------
# JWT signing secret (min 32 characters in production)
BEAST_JWT_SECRET=super_secret_jwt_token_beast_ctf_auth_key_must_be_long

# Operator Bearer token for /readyz health diagnostics (min 16 chars in production)
BEAST_OPERATOR_TOKEN=beast_operator_readiness_probe_secret_token

# Basic auth password protecting /docs and /openapi.json when enabled in production
BEAST_DOCS_PASSWORD=beast_docs_admin_password

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=beast
POSTGRES_PASSWORD=doorword
POSTGRES_DB=beast
POSTGRES_SSLMODE=disable

# Overrides DB password directly if using standard Beast config
BEAST_DB_PASSWORD=doorword

# ------------------------------------------------------------------------------
# Redis Cache & Session Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=beast
REDIS_PASSWORD=doorword
REDIS_DEFAULT_PASSWORD=redis_default_password
REDIS_DB=0

# Overrides Redis password directly if using standard Beast config
BEAST_REDIS_PASSWORD=doorword
BEAST_REDIS_DEFAULT_PASSWORD=redis_default_password

# ------------------------------------------------------------------------------
# SMTP Mailer Configuration (E-mail OTPs, Password Reset, Verification)
# ------------------------------------------------------------------------------
# SMTP Password override (matches BEAST_SMTP_PASSWORD in config)
BEAST_SMTP_PASSWORD=smtp_app_password_here

# ------------------------------------------------------------------------------
# Outgoing Webhook Secrets (Optional per-webhook overrides)
# ------------------------------------------------------------------------------
# HMAC secret for signing outgoing notification webhooks (url_env / secret_env)
# BEAST_WEBHOOK_DISCORD_SECRET=whsec_examplewebhooksecret
